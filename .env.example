# Copy this file to .env in the repo root and adjust as needed.

# API (apps/api)
DATABASE_URL=postgres://cami:cami@localhost:5432/cami
PORT=3001

# Which classifier provider backs POST /requests/classify.
# "keyword" (default) or "llm" (simulated - no API key needed).
CLASSIFIER_PROVIDER=keyword

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001
